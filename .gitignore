# quarantined for manual deletion (the device bridge cannot delete)
_to_delete/

*.tmp

# git lock droppings left behind when running over the device bridge
*.lock
*.junk*
# ...but not Cargo's, which pins the build and belongs in the repo. The rule
# above was written for git's droppings and caught this by accident.
!Cargo.lock

# rust build output. Regenerable, and the incremental dep-graph blobs are
# ~10 MB each and rewritten on every compile, so tracking them buries every
# real diff and grows the history by tens of megabytes a commit.
target/

# macOS finder droppings
.DS_Store

# the app's own state, kept beside the launcher: chosen library, tag overrides,
# markers, presets, sessions, scan index. Per-machine — the library path is not
# the same on the Mac and the PC — so it is deliberately not tracked.
data/

# Built programs. They were tracked until the classifier went in and took them
# from 4.7 MB to 74 MB — which git keeps forever, and again on every refresh.
# The launchers build from source when these are absent, so a fresh clone still
# works; it just takes a minute the first time.
bin/

# Development tooling for the interface tests. The application needs none of
# this — it is one Rust binary — so none of it belongs in the repository.
node_modules/
test-results/
playwright-report/

# Sweep output: regenerated by `node tools/glitch-sweep.mjs`, and one run is
# ~1.5 MB of JSON that nothing reads except the report beside it.
docs/glitch-sweep/
